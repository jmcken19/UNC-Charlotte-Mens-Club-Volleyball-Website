{
  "name": "uncc-mens-volleyball-site",
  "version": "1.0.0",
  "description": "UNC Charlotte Men's Club Volleyball website + owner editor (made from client-site-template)",
  "private": true,
  "type": "module",
  "scripts": {
    "new-client": "node scripts/new-client.mjs",
    "configure": "node scripts/configure.mjs",
    "build": "node scripts/build.mjs",
    "build:preview": "node scripts/build.mjs --preview",
    "build:live": "node scripts/build.mjs --out dist-prod",
    "photo": "node scripts/prepare-photo.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:ui": "node tests/ui-editor.mjs",
    "shots": "node scripts/screenshots.mjs",
    "dns:snapshot": "node scripts/dns-snapshot.mjs",
    "design:check": "node scripts/build.mjs && impeccable detect --no-advisory dist",
    "test:visual": "node tests/ui-visual.mjs && node tests/ui-visual-edge.mjs && node tests/ui-text.mjs",
    "editor:demo": "node scripts/editor-demo.mjs"
  },
  "devDependencies": {
    "@fontsource/barlow": "^5.3.0",
    "@fontsource/barlow-condensed": "^5.3.0",
    "@fontsource/source-sans-pro": "^5.3.0",
    "heic2any": "^0.0.4",
    "impeccable": "^4.8.2",
    "miniflare": "^4.20260730.0",
    "puppeteer-core": "^25.16.0",
    "sharp": "^0.35.5",
    "wrangler": "^4.158.0"
  }
}
